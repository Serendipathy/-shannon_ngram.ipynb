# Copy to .env and edit. Every setting below has the default shown.
# .env is gitignored; this file is committed.

# ngrams.dev REST API base URL
NGRAM_API_BASE_URL=https://api.ngrams.dev

# Corpus code (eng, ger, ...)
NGRAM_CORPUS=eng

# Words of context used for the next-word distribution
NGRAM_CONTEXT_LENGTH=4

# Lowest context length the backoff walk will try
NGRAM_MIN_CONTEXT_LENGTH=1

# Hard cap on sentences per paragraph
NGRAM_MAX_SENTENCES=5

# Length guard: words per sentence before the sentence is closed
NGRAM_MAX_SENTENCE_WORDS=40

# Rows per API request (API maximum is 100)
NGRAM_RESULT_LIMIT=100

# Pages fetched per context (1 = top NGRAM_RESULT_LIMIT rows only)
NGRAM_MAX_PAGES=1

# SQLite cache file; default is ~/.cache/shannon_ngram/ngrams.sqlite3
NGRAM_CACHE_PATH=

# HTTP timeout in seconds
NGRAM_REQUEST_TIMEOUT=10.0

# Retries on 429 and 5xx responses
NGRAM_MAX_RETRIES=3

# true sends flags=cs (case-sensitive search) instead of aggregating case variants
NGRAM_CASE_SENSITIVE=false

# User-Agent header sent with every request
NGRAM_USER_AGENT=shannon-ngram/0.1
